local function countMatches(str, pattern)
	local count = 0
	string.gsub(str, pattern, function() count = count + 1 end)
	return count
end

-- Basic bracket/control flow balance checker
local function checkBalances(code)
	local lines = code:split("\n")
	local functionLine, ifLine, whileLine, forLine, doLine, endCount = 0,0,0,0,0,0
	local issues = {}
	
	for i, line in ipairs(lines) do
		local trimmed = line:gsub("%s*%-%-.*", ""):gsub("%s+", "")
		if trimmed:match("^function%s") then functionLine += 1 end
		if trimmed:match("^%s*if%s") then ifLine += 1 end
		if trimmed:match("^%s*while%s") then whileLine += 1 end
		if trimmed:match("^%s*for%s") then forLine += 1 end
		if trimmed:match("^%s*do%s*$") or trimmed:match("^%s*do%s") then doLine += 1 end
		-- crude end detection
		if line:match("^%s*end%s*$") then endCount += 1 end
		if line:match("^%s*end[%s%)]") then endCount += 1 end
	end
	
	local totalOpens = functionLine + ifLine + whileLine + forLine + doLine
	if totalOpens > endCount then
		table.insert(issues, string.format("⚖️ Unbalanced control structures: %d opens vs %d 'end's. Missing 'end'?", totalOpens, endCount))
	elseif totalOpens < endCount then
		table.insert(issues, string.format("⚖️ Too many 'end' statements: %d opens, %d 'end's. Extra 'end'?", totalOpens, endCount))
	end
	
	local openP = countMatches(code, "%(")
	local closeP = countMatches(code, "%)")
	if openP ~= closeP then
		table.insert(issues, string.format("❌ Parentheses imbalance: %d '(' vs %d ')'.", openP, closeP))
	end
	
	local openB = countMatches(code, "%[")
	local closeB = countMatches(code, "%]")
	if openB ~= closeB then
		table.insert(issues, string.format("❌ Bracket imbalance: %d '[' vs %d ']'.", openB, closeB))
	end
	
	local doubleQ = countMatches(code, '"')
	if doubleQ % 2 ~= 0 then
		table.insert(issues, "❌ Odd number of double quotes. Missing closing quote?")
	end
	local singleQ = countMatches(code, "'")
	if singleQ % 2 ~= 0 then
		table.insert(issues, "❌ Odd number of single quotes. Missing closing quote?")
	end
	
	return issues
end

-- Local syntax and static analysis
local function localAnalysis(code)
	local results = {}
	
	-- Syntax check
	local success, err = pcall(function() loadstring(code) end)
	if not success then
		table.insert(results, "🔴 SYNTAX ERROR: " .. tostring(err))
		local line = string.match(err, ":(%d+):")
		if line then
			table.insert(results, string.format("  → Error near line %d.", line))
		end
	else
		table.insert(results, "🟢 Syntax check passed.")
	end
	
	-- Balance checks
	local static = checkBalances(code)
	if #static > 0 then
		table.insert(results, "🔍 Structural issues found:")
		for _, v in ipairs(static) do
			table.insert(results, "  " .. v)
		end
	else
		table.insert(results, "✅ No obvious bracket/structural imbalances.")
	end
	
	return table.concat(results, "\n")
end

-- Runtime test in a safe(ish) environment
local function runtimeTest(code)
	local output = {}
	
	local success, err = pcall(function()
		local testFunc = loadstring(code)
		if testFunc then
			-- Provide a limited environment (not fully sandboxed, but safe enough for testing)
			local env = setmetatable({
				print = function(...) table.insert(output, "PRINT: " .. table.concat({...}, "\t")) end,
				warn = function(...) table.insert(output, "WARN: " .. table.concat({...}, "\t")) end,
				error = function(...) error(...) end,
				wait = function(t) if t and t > 5 then error("Timeout") end end,
			}, { __index = function(t, k)
				-- Allow access to safe global functions but restrict dangerous ones
				if k == "Instance" or k == "game" or k == "workspace" then
					return nil -- block direct access to Roblox objects in test
				end
				return getgenv()[k] or _G[k]  -- careful: getgenv() may not exist; use _G
			end})
			setfenv(testFunc, env)
			testFunc()
		end
	end)
	
	if not success then
		table.insert(output, 1, "🔴 RUNTIME ERROR: " .. tostring(err))
		local line = string.match(err, ":(%d+):")
		if line then
			table.insert(output, "  → Error near line " .. line)
		end
	else
		table.insert(output, 1, "🟢 Runtime test finished without fatal errors.")
	end
	
	return table.concat(output, "\n")
end

-- ===========================
--   AI API INTEGRATION
-- ===========================
local function aiAnalysis(code)
	-- Build request body
	local requestData = {
		model = MODEL,
		messages = {
			{
				role = "system",
				content = "You are a helpful Roblox scripting assistant."
			},
			{
				role = "user",
				content = AI_PROMPT_PREFIX .. code
			}
		},
		temperature = 0.3,
		max_tokens = 2000
	}
	
	local requestBody = HttpService:JSONEncode(requestData)
	
	local headers = {
		["Content-Type"] = "application/json",
		["Authorization"] = "Bearer " .. API_KEY
	}
	
	-- Perform the request (synchronous because we use coroutine.wrap for async feel)
	local success, response = pcall(function()
		return HttpService:PostAsync(API_URL, requestBody, Enum.HttpContentType.ApplicationJson, false, headers)
	end)
	
	if not success then
		return "❌ AI API call failed: " .. tostring(response)
	end
	
	local decoded, decodeError = pcall(function() return HttpService:JSONDecode(response) end)
	if not decoded then
		return "❌ Failed to parse AI response: " .. tostring(decodeError)
	end
	
	-- Extract content from typical OpenAI chat completion format
	if decoded.choices and decoded.choices[1] then
		local message = decoded.choices[1].message
		if message and message.content then
			return "🤖 AI ANALYSIS:\n" .. message.content
		end
	end
	
	return "❌ Unexpected AI response format."
end

