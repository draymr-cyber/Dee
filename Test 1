local featureNames = {
	"NoFallDamage", "ClickTeleport", "AntiRagdoll", "ToolReach",
	"InstantEquip", "SeeThroughWalls", "HitboxExpansion",
	"CharacterDesync", "LagSwitch", "AntiAFK"
}
